# Kopiere diese Datei zu ".env.local" und trage deine eigenen Schlüssel ein
# (siehe README.md, Abschnitt "Einrichtung").
FRED_API_KEY=hier_deinen_schluessel_einfuegen
ANTHROPIC_API_KEY=hier_deinen_schluessel_einfuegen

# Push-Benachrichtigungen (Web Push / VAPID)
# Generieren mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine@email.de
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Speicher für Push-Abos & Cron-Status (kostenloses Konto: https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zufälliger String zum Schutz des Cron-Endpunkts, z.B. mit:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
